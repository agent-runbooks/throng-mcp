{
    "name": "throng-mcp",
    "version": "0.5.0",
    "description": "MCP server that delegates work to another agent harness or model over ACP",
    "license": "MIT",
    "author": "Maksim Zemskov <maxaz74@gmail.com>",
    "keywords": [
        "mcp",
        "mcp-server",
        "acp",
        "agent-client-protocol",
        "claude-code",
        "codex",
        "opencode",
        "gemini-cli",
        "subagents",
        "delegation"
    ],
    "homepage": "https://github.com/agent-runbooks/throng-mcp#readme",
    "bugs": {
        "url": "https://github.com/agent-runbooks/throng-mcp/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/agent-runbooks/throng-mcp.git"
    },
    "type": "module",
    "bin": {
        "throng-mcp": "dist/mcp.js"
    },
    "files": [
        "dist",
        "skills",
        "docs",
        "README.md",
        "LICENSE"
    ],
    "engines": {
        "node": "^22.13 || >=24"
    },
    "packageManager": "pnpm@11.10.0",
    "scripts": {
        "start": "node src/mcp.ts",
        "build": "tsdown",
        "prepack": "pnpm run build",
        "typecheck": "tsc --noEmit",
        "test": "vitest --run",
        "test:watch": "vitest",
        "lint": "eslint .",
        "fmt": "prettier --write . --log-level error",
        "ci:lint": "eslint .",
        "ci:fmt": "prettier --check .",
        "ci:typecheck": "tsc --noEmit",
        "ci:tests": "vitest --run",
        "ci:build": "tsdown",
        "changeset": "changeset add",
        "ci:changesets": "changeset status --since=origin/main",
        "ci:version": "changeset version",
        "ci:publish": "pnpm run ci:build && changeset publish",
        "smoke": "node scripts/smoke/smoke.ts",
        "smoke:claude": "node scripts/smoke/smoke.ts claude/sonnet",
        "smoke:claude-schema": "node scripts/smoke/smoke.ts claude/sonnet --schema",
        "smoke:codex": "node scripts/smoke/smoke.ts codex/gpt-6-luna",
        "smoke:codex-schema": "node scripts/smoke/smoke.ts codex/gpt-6-luna --schema",
        "smoke:opencode": "node scripts/smoke/smoke.ts opencode/openrouter/z-ai/glm-5.3-flash",
        "smoke:opencode-schema": "node scripts/smoke/smoke.ts opencode/openrouter/z-ai/glm-5.3-flash --schema",
        "smoke:gemini": "node scripts/smoke/smoke.ts gemini/auto",
        "smoke:gemini-schema": "node scripts/smoke/smoke.ts gemini/auto --schema"
    },
    "devDependencies": {
        "@agentclientprotocol/sdk": "^1.5.0",
        "@changesets/changelog-github": "^1.0.1",
        "@changesets/cli": "^3.0.3",
        "@eslint/js": "^10.0.1",
        "@modelcontextprotocol/sdk": "^1.30.1",
        "@types/node": "^22.20.4",
        "ajv": "^8.20.0",
        "eslint": "^10.11.0",
        "lefthook": "^2.1.14",
        "prettier": "^3.9.9",
        "tsdown": "^0.23.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.70.1",
        "vitest": "^5.0.2",
        "yaml": "^2.9.1",
        "zod": "^4.6.5"
    }
}
